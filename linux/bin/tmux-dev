#!/usr/bin/env bash

TEAMS=0
POSITIONAL=()

for arg in "$@"; do
  case $arg in
    --teams|-T)
      TEAMS=1
      ;;
    *)
      POSITIONAL+=("$arg")
      ;;
  esac
done

SESSION="${POSITIONAL[0]:-dev}"
PROJECT_PATH="${POSITIONAL[1]:-$HOME}"

# Don't create if session already exists
tmux has-session -t "$SESSION" 2>/dev/null && tmux switch-client -t "$SESSION" && exit 0

tmux new-session -d -s "$SESSION" -c "$PROJECT_PATH"

# Window 1: claude (full width)
tmux rename-window -t "$SESSION:1" "claude"
if [ "$TEAMS" = "1" ]; then
  tmux set-option -t "$SESSION" @teams "1"
  tmux send-keys -t "$SESSION:1" "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 claude" Enter
else
  tmux send-keys -t "$SESSION:1" "claude" Enter
fi

# Window 2: split — agent left, shell right
tmux new-window -t "$SESSION:2" -n "workspace" -c "$PROJECT_PATH"
tmux split-window -t "$SESSION:2" -h -c "$PROJECT_PATH"
tmux select-pane -t "$SESSION:2.1" # focus left pane

# Window 3: logs
tmux new-window -t "$SESSION:3" -n "logs" -c "$PROJECT_PATH"

# Start on window 1
tmux select-window -t "$SESSION:1"

# Attach (or switch if already in tmux)
if [ -z "$TMUX" ]; then
  tmux attach-session -t "$SESSION"
else
  tmux switch-client -t "$SESSION"
fi
