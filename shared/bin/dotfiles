#!/usr/bin/env python3
"""dotfiles: install, link and reset this dotfiles repo.

  dotfiles install              pick tools to install interactively
  dotfiles install TOOL...      install specific tools (-n preview, -y no prompt)
  dotfiles install --all        install everything and link all configs
  dotfiles link                 re-run dotbot (symlinks only)
  dotfiles dotbot               check for a newer Dotbot version
  dotfiles dotbot --update      switch the vendored dotbot/ to the newest version
  dotfiles dotbot VERSION       switch it to a specific version (up or down)
  dotfiles dotbot --list        list available versions
  dotfiles list                 show tools and what's linked/installed
  dotfiles reset                pick tools to reset interactively
  dotfiles reset TOOL...        reset specific tools (-n preview, -y no prompt)
  dotfiles reset --all          reset everything
  dotfiles upgrade              pick outdated tools to upgrade interactively
  dotfiles upgrade TOOL...      upgrade specific tools (-n preview, -y no prompt)
  dotfiles upgrade --all        upgrade everything (on Arch: always the whole system)
  dotfiles outdated             print outdated packages from tools.yaml, one per line (macOS)

Tools are defined in tools.yaml; symlinks come from install.conf.yaml.
Reset only removes symlinks that point into this repo, never real files.
On Windows, ~/.local/bin/dotfiles.cmd runs this through Python.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request

try:
    import yaml
except ImportError:
    sys.exit("error: PyYAML is required (dotbot needs it too): python3 -m pip install pyyaml")

# shared/bin/dotfiles -> repo root (resolves the ~/.local/bin symlink)
REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
OS = {"darwin": "macos", "linux": "linux", "win32": "windows"}.get(sys.platform)
sys.stdout.reconfigure(line_buffering=True)  # keep our output in order with brew/dotbot output

if sys.stdout.isatty():
    if OS == "windows":
        os.system("")  # enable ANSI escapes in the Windows console
    RED, GREEN, YELLOW, BLUE, DIM, NC = "\033[0;31m", "\033[0;32m", "\033[1;33m", "\033[0;34m", "\033[2m", "\033[0m"
else:
    RED = GREEN = YELLOW = BLUE = DIM = NC = ""


# --- repo config ---------------------------------------------------------------

def load_yaml(name):
    with open(os.path.join(REPO, name)) as f:
        return yaml.safe_load(f)


LOCAL_FILE = "tools.local.yaml"
local_names = set()  # tools that came from LOCAL_FILE, filled in by load_tools


def load_tool_file(name):
    try:
        data = load_yaml(name)
    except yaml.YAMLError as e:
        sys.exit(f"error: {name} isn't valid YAML:\n{e}")
    if data is None:
        return {}
    if not isinstance(data, dict) or not all(isinstance(t, dict) or t is None for t in data.values()):
        sys.exit(f"error: {name} must map tool names to settings (see tools.yaml)")
    return {str(name): tool or {} for name, tool in data.items()}


def load_local_tools():
    """Tools from the untracked LOCAL_FILE: none when it's missing, and always none on Windows."""
    if OS == "windows" or not os.path.exists(os.path.join(REPO, LOCAL_FILE)):
        return {}
    tools = load_tool_file(LOCAL_FILE)
    for name, tool in tools.items():
        if "links" in tool:
            sys.exit(f"error: {LOCAL_FILE}: {name} has links:, which only tools.yaml can have "
                     f"(list its config files under config:, or `dotfiles promote {name}`)")
    return tools


def check_collisions(tracked, local, fix=f"; remove it from {LOCAL_FILE}"):
    """Local tools can't reuse a tracked tool's name, or a package it installs on the same OS."""
    for name in local:
        if name in tracked:
            sys.exit(f"error: {name} is already in tools.yaml{fix} (or rename it)")
    for os_name in ("macos", "linux", "windows"):
        claimed = {pkg_name(p): name for name, tool in tracked.items() for p in tool.get(os_name, [])}
        for name, tool in local.items():
            for p in tool.get(os_name, []):
                if pkg_name(p) in claimed:
                    sys.exit(f"error: {p} ({os_name}) is already installed by {claimed[pkg_name(p)]} in tools.yaml{fix}")


def load_tools():
    """Tools from tools.yaml, then the ones from LOCAL_FILE."""
    tracked, local = load_tool_file("tools.yaml"), load_local_tools()
    for name, tool in tracked.items():
        if "config" in tool:
            sys.exit(f"error: tools.yaml: {name} has config:, which only {LOCAL_FILE} can have "
                     f"(tracked tools list their config under links:)")
    check_collisions(tracked, local)
    local_names.clear()
    local_names.update(local)
    return {**tracked, **local}


def install_links():
    """Every link in install.conf.yaml. The same destination can be listed once per OS."""
    links = []
    for directive in load_yaml("install.conf.yaml"):
        for key, spec in (directive.get("link") or {}).items():
            source = spec["path"] if isinstance(spec, dict) else spec
            cond = spec.get("if") if isinstance(spec, dict) else None
            links.append({"key": key, "dest": os.path.expanduser(key), "source": source, "spec": spec, "if": cond})
    return links


def unique(links):
    """Drop repeated destinations, keeping the first."""
    seen = set()
    return [l for l in links if not (l["dest"] in seen or seen.add(l["dest"]))]


def link_defaults():
    for directive in load_yaml("install.conf.yaml"):
        if "defaults" in directive:
            return directive["defaults"]
    return {}


_conditions = {}


def applies(link):
    """Evaluate a link's `if` the way dotbot does: shell exit status 0 means true."""
    cond = link["if"]
    if not cond:
        return True
    if cond not in _conditions:
        kwargs = {} if OS == "windows" else {"executable": "/bin/bash"}  # same shell run_dotbot gives dotbot
        _conditions[cond] = subprocess.run(
            cond, shell=True, cwd=REPO, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, **kwargs
        ).returncode == 0
    return _conditions[cond]


def owned(link):
    """True if the link's destination is a symlink that points at its source in this repo."""
    dest = link["dest"]
    return os.path.islink(dest) and os.path.realpath(dest) == os.path.realpath(os.path.join(REPO, link["source"]))


def under(source, prefixes):
    return any(source == p or source.startswith(p.rstrip("/") + "/") for p in prefixes)


def tool_links(tool, links):
    return [l for l in links if under(l["source"], tool.get("links", []))]


# --- package managers ------------------------------------------------------------

def scoop():
    return shutil.which("scoop") or "scoop"


def pkg_name(pkg):
    """Scoop packages can be written bucket/app; the installed name is the app."""
    return pkg.split("/")[-1]


def installed_packages():
    """Names of everything installed by this OS's package manager."""
    try:
        if OS == "macos":
            out = subprocess.run(["brew", "list", "-1"], capture_output=True, text=True).stdout
            return set(out.split())
        if OS == "linux":
            out = subprocess.run(["pacman", "-Qq"], capture_output=True, text=True).stdout
            return set(out.split())
        apps = os.path.join(os.environ.get("SCOOP") or os.path.expanduser("~/scoop"), "apps")
        return {name.lower() for name in os.listdir(apps)}
    except OSError:
        return set()


def is_installed(pkg, installed):
    name = pkg_name(pkg)
    return (name.lower() if OS == "windows" else name) in installed


def install_packages(pkgs):
    if OS == "macos":
        subprocess.run(["brew", "install"] + pkgs, check=True)
    elif OS == "linux":
        subprocess.run(["paru", "-S", "--needed"] + pkgs, check=True)
    else:
        for bucket in {p.split("/")[0] for p in pkgs if "/" in p}:
            subprocess.run([scoop(), "bucket", "add", bucket], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run([scoop(), "install"] + pkgs, check=True)


def uninstall_packages(pkgs):
    names = [pkg_name(p) for p in pkgs]
    if OS == "macos":
        subprocess.run(["brew", "uninstall"] + names, check=True)
    elif OS == "linux":
        subprocess.run(["paru", "-Rns", "--noconfirm"] + names, check=True)
    else:
        subprocess.run([scoop(), "uninstall"] + names, check=True)


def outdated_packages(quiet=False):
    """Names of outdated packages, or None when the package manager can't tell cheaply (Scoop)."""
    if OS == "macos":
        if not quiet:
            print(f"{YELLOW}→{NC} Checking for updates (brew update)...")
        subprocess.run(["brew", "update", "--quiet"], stdout=subprocess.DEVNULL)
        out = subprocess.run(["brew", "outdated", "--json=v2"], capture_output=True, text=True, check=True).stdout
        data = json.loads(out)
        return {f["name"] for f in data["formulae"]} | {c["name"] for c in data["casks"]}
    return None


def upgrade_packages(pkgs):
    names = [pkg_name(p) for p in pkgs]
    if OS == "macos":
        subprocess.run(["brew", "upgrade"] + names, check=True)
    else:
        subprocess.run([scoop(), "update"] + names, check=True)


def run_dotbot(config):
    env = dict(os.environ)
    if OS != "windows":
        env["SHELL"] = "/bin/bash"
    dotbot = [sys.executable, os.path.join("dotbot", "bin", "dotbot"), "-d", ".", "-c", config]
    subprocess.run(dotbot, cwd=REPO, env=env, check=True)


def link_only(links):
    """Run dotbot with a config holding just these links, so it handles if/create/relink as usual."""
    config = [{"defaults": {"link": link_defaults().get("link", {})}}, {"link": {l["key"]: l["spec"] for l in links}}]
    fd, path = tempfile.mkstemp(suffix=".json")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(config, f)
        run_dotbot(path)
    finally:
        os.remove(path)


# --- plans -------------------------------------------------------------------------
#
# A plan is a list of steps, one per tool:
#   {"name", "action": "install"|"reset"|"upgrade", "packages": [...], "links": [link...], "run": [cmd...]}

def build_reset_plan(names, tools, include_unclaimed=False):
    links = install_links()
    installed = installed_packages()
    plan = []
    for name in names:
        tool = tools[name]
        plan.append({
            "name": name,
            "action": "reset",
            "links": unique([l for l in tool_links(tool, links) if owned(l)]),
            "run": (tool.get("reset") or {}).get(OS, []),
            "packages": [p for p in tool.get(OS, []) if is_installed(p, installed)],
        })

    if include_unclaimed:
        claimed = [p for t in tools.values() for p in t.get("links", [])]
        rest = unique([l for l in links if not under(l["source"], claimed) and owned(l)])
        if rest:
            plan.append({"name": "other links", "action": "reset", "links": rest, "run": [], "packages": []})

    return [step for step in plan if step["links"] or step["run"] or step["packages"]]


def set_up(tool):
    """True when the tool's check command for this OS passes, so its install commands can be skipped."""
    cmd = (tool.get("check") or {}).get(OS)
    if not cmd:
        return False
    return subprocess.run(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def build_install_plan(names, tools):
    links = install_links()
    installed = installed_packages()
    plan = []
    for name in names:
        tool = tools[name]
        plan.append({
            "name": name,
            "action": "install",
            "links": unique([l for l in tool_links(tool, links) if applies(l) and not owned(l)]),
            "run": [] if set_up(tool) else (tool.get("install") or {}).get(OS, []),
            "packages": [p for p in tool.get(OS, []) if not is_installed(p, installed)],
        })
    return [step for step in plan if step["links"] or step["run"] or step["packages"]]


def build_upgrade_plan(names, tools):
    """Installed packages with updates (all installed ones when that can't be checked), plus upgrade hooks."""
    installed = installed_packages()
    outdated = outdated_packages()
    plan = []
    for name in names:
        tool = tools[name]
        plan.append({
            "name": name,
            "action": "upgrade",
            "links": [],
            "run": (tool.get("upgrade") or {}).get(OS, []),
            "packages": [
                p for p in tool.get(OS, [])
                if is_installed(p, installed) and (outdated is None or pkg_name(p) in outdated)
            ],
        })
    return [step for step in plan if step["run"] or step["packages"]]


PACKAGE_VERB = {"install": "install", "reset": "uninstall", "upgrade": "upgrade"}
LINK_VERB = {"install": "link", "reset": "unlink", "upgrade": "link"}


def summary(step):
    parts = []
    if step["packages"]:
        parts.append(PACKAGE_VERB[step["action"]] + " " + " ".join(step["packages"]))
    if step["links"]:
        parts.append(f"{LINK_VERB[step['action']]} {len(step['links'])}")
    if step["run"]:
        parts.append(f"run {len(step['run'])}")
    return " · ".join(parts)


def print_plan(plan):
    for step in plan:
        action = step["action"]
        # same order the steps run in: reset removes packages last, the others install them first
        lines = [f"  {LINK_VERB[action]:<9}  {link['dest']}" for link in step["links"]]
        lines += [f"  run        {cmd}" for cmd in step["run"]]
        if step["packages"]:
            pkgs = f"  {PACKAGE_VERB[action]:<9}  {' '.join(step['packages'])}"
            lines = lines + [pkgs] if action == "reset" else [pkgs] + lines
        print(f"{BLUE}{step['name']}{NC}")
        print("\n".join(lines))


def unlink(path):
    try:
        os.unlink(path)
    except (IsADirectoryError, PermissionError):
        os.rmdir(path)  # directory symlinks on Windows


def execute_reset(plan):
    failed = []
    for step in plan:
        print(f"{YELLOW}→{NC} Resetting {step['name']}...")
        try:
            for link in step["links"]:
                unlink(link["dest"])
            for cmd in step["run"]:
                subprocess.run(cmd, shell=True, check=True)
            if step["packages"]:
                uninstall_packages(step["packages"])
        except (OSError, subprocess.CalledProcessError) as e:
            print(f"{RED}✗{NC} {step['name']}: {e}")
            failed.append(step["name"])
        else:
            print(f"{GREEN}✓{NC} {step['name']}")
    return failed


def execute_install(plan, link_all):
    """Install packages, then link (all of install.conf.yaml or just the plan's links), then run hooks."""
    failed = []
    for step in plan:
        if step["packages"]:
            print(f"{YELLOW}→{NC} Installing {step['name']}...")
            try:
                install_packages(step["packages"])
            except (OSError, subprocess.CalledProcessError) as e:
                print(f"{RED}✗{NC} {step['name']}: {e}")
                failed.append(step["name"])

    links = [l for step in plan if step["name"] not in failed for l in step["links"]]
    if link_all or links:
        print(f"{YELLOW}→{NC} Linking configs...")
        try:
            run_dotbot("install.conf.yaml") if link_all else link_only(links)
        except (OSError, subprocess.CalledProcessError) as e:
            print(f"{RED}✗{NC} links: {e}")
            failed.append("links")

    for step in plan:
        if step["run"] and step["name"] not in failed:
            print(f"{YELLOW}→{NC} Setting up {step['name']}...")
            try:
                for cmd in step["run"]:
                    subprocess.run(cmd, shell=True, check=True)
            except (OSError, subprocess.CalledProcessError) as e:
                print(f"{RED}✗{NC} {step['name']}: {e}")
                failed.append(step["name"])

    return failed


def execute_upgrade(plan):
    failed = []
    for step in plan:
        print(f"{YELLOW}→{NC} Upgrading {step['name']}...")
        try:
            if step["packages"]:
                upgrade_packages(step["packages"])
            for cmd in step["run"]:
                subprocess.run(cmd, shell=True, check=True)
        except (OSError, subprocess.CalledProcessError) as e:
            print(f"{RED}✗{NC} {step['name']}: {e}")
            failed.append(step["name"])
        else:
            print(f"{GREEN}✓{NC} {step['name']}")
    return failed


def confirm(prompt):
    try:
        return input(prompt).strip().lower() in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


# --- interactive picker ------------------------------------------------------------

UP, DOWN, TOGGLE, ALL, DONE, QUIT = "up", "down", "toggle", "all", "done", "quit"


def read_keys():
    """Yield key actions from the terminal until the caller stops."""
    if OS == "windows":
        import msvcrt
        while True:
            ch = msvcrt.getwch()
            if ch in ("\x00", "\xe0"):
                ch = {"H": UP, "P": DOWN}.get(msvcrt.getwch())
            yield key_action(ch)
    else:
        import termios
        import tty
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setcbreak(fd)
            while True:
                seq = os.read(fd, 3).decode(errors="ignore")
                yield {"\x1b[A": UP, "\x1b[B": DOWN}.get(seq) or key_action(seq)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)


def key_action(ch):
    return {
        UP: UP, DOWN: DOWN, "k": UP, "j": DOWN,
        " ": TOGGLE, "a": ALL,
        "\r": DONE, "\n": DONE,
        "q": QUIT, "\x1b": QUIT, "\x03": QUIT,
    }.get(ch)


def fit(text, room):
    """Cut text to room characters so terminal lines never wrap (wrapping breaks redraws)."""
    return text if len(text) <= room else text[:max(room - 1, 0)] + "…"


def pick(plan, title):
    """Checkbox menu over plan steps; returns the chosen steps, or None if cancelled."""
    selected = [False] * len(plan)
    cursor, top, drawn = 0, 0, 0
    # local tools come last, under their own heading (one more line to fit)
    first_local = next((i for i, s in enumerate(plan) if s["name"] in local_names), None)
    height = max(3, min(len(plan), shutil.get_terminal_size().lines - 5 - (first_local is not None)))
    width = max(len(s["name"]) for s in plan)

    def draw():
        nonlocal drawn
        cols = shutil.get_terminal_size().columns - 1  # writing the last column can wrap too
        lines = [
            fit(title, cols),
            DIM + fit("↑/↓ move · space toggle · a all · enter confirm · q quit", cols) + NC,
        ]
        for i in range(top, min(top + height, len(plan))):
            if i == first_local:
                lines.append(DIM + fit(f"  local ({LOCAL_FILE})", cols) + NC)
            mark = f"{GREEN}[x]{NC}" if selected[i] else "[ ]"
            pointer = f"{BLUE}>{NC}" if i == cursor else " "
            name = fit(plan[i]["name"], cols - 6).ljust(width)
            detail = fit(summary(plan[i]), cols - 6 - width - 2)
            lines.append(f"{pointer} {mark} {name}  {DIM}{detail}{NC}")
        if drawn:
            sys.stdout.write(f"\033[{drawn}F")
        sys.stdout.write("\033[J" + "\n".join(lines) + "\n")
        sys.stdout.flush()
        drawn = len(lines)

    sys.stdout.write("\033[?25l")  # hide cursor
    try:
        draw()
        for action in read_keys():
            if action == UP:
                cursor = (cursor - 1) % len(plan)
            elif action == DOWN:
                cursor = (cursor + 1) % len(plan)
            elif action == TOGGLE:
                selected[cursor] = not selected[cursor]
            elif action == ALL:
                selected = [not all(selected)] * len(plan)
            elif action == DONE:
                return [s for s, on in zip(plan, selected) if on]
            elif action == QUIT:
                return None
            top = min(max(top, cursor - height + 1), cursor)
            draw()
    except KeyboardInterrupt:
        return None
    finally:
        sys.stdout.write("\033[?25h")  # show cursor
        sys.stdout.flush()


# --- editing tool files --------------------------------------------------------------
#
# PyYAML would drop comments, so these edit tools.yaml and LOCAL_FILE as text: each
# tool is an unindented key that runs until the next unindented line, and the comment
# lines right above it belong to it.

LOCAL_HEADER = """\
# Tools for this machine only: untracked, and read by `dotfiles` on macOS and Linux.
# Same settings as tools.yaml, minus links:, plus config: (this tool's config files as
# home paths; `dotfiles promote` moves them into the repo and links them).
"""


def read_text(name):
    path = os.path.join(REPO, name)
    if not os.path.exists(path):
        return ""
    with open(path) as f:
        return f.read()


def write_text(name, text):
    with open(os.path.join(REPO, name), "w") as f:
        f.write(text)


def flow(items):
    """A one-line YAML list, quoting only what needs it."""
    return yaml.safe_dump(list(items), default_flow_style=True, width=float("inf")).strip()


def block_span(lines, name):
    """(start, end) of a tool's lines, including the comments right above it, or None."""
    key = re.compile(rf"""^["']?{re.escape(name)}["']?\s*:""")
    for i, line in enumerate(lines):
        if key.match(line):
            end = i + 1
            while end < len(lines) and (not lines[end].strip() or lines[end][0] in " \t"):
                end += 1
            while not lines[end - 1].strip():
                end -= 1
            start = i
            while start > 0 and lines[start - 1].startswith("#"):
                start -= 1
            return start, end
    return None


def get_block(text, name):
    lines = text.splitlines()
    start, end = block_span(lines, name)
    return "\n".join(lines[start:end])


def remove_block(text, name):
    lines = text.splitlines()
    start, end = block_span(lines, name)
    del lines[start:end]
    if start < len(lines) and not lines[start].strip() and (start == 0 or not lines[start - 1].strip()):
        del lines[start]  # the blank line that separated it
    while lines and not lines[-1].strip():
        lines.pop()
    return "\n".join(lines) + "\n" if lines else ""


def append_block(text, block):
    return (text.rstrip("\n") + "\n\n" if text.strip() else "") + block + "\n"


def set_key(block, key, values):
    """Set (or with no values, drop) one of a tool block's lists, keeping the rest as written."""
    lines = block.split("\n")
    at = next((i for i, l in enumerate(lines) if re.match(rf"  {key}\s*:", l)), None)
    if at is not None:
        end = at + 1
        while end < len(lines) and (lines[end].startswith("   ") or lines[end].startswith("  - ")):
            end += 1
        del lines[at:end]
    if values:
        lines.insert(len(lines) if at is None else at, f"  {key}: {flow(values)}")
    return "\n".join(lines)


def tool_block(name, packages, config=None):
    lines = [f"{name}:"]
    lines += [f"  {os_name}: {flow(pkgs)}" for os_name, pkgs in packages.items() if pkgs]
    if config:
        lines.append(f"  config: {flow(config)}")
    return "\n".join(lines)


def home_path(path):
    """path as ~/..., the way tools files and install.conf.yaml write it."""
    path = os.path.abspath(os.path.expanduser(path))
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path == home or path.startswith(home + os.sep) else path


def config_guesses(name):
    """Config paths that exist under the usual names for a tool."""
    guesses = [f"~/.config/{name}", f"~/.{name}", f"~/.{name}rc"]
    if OS == "macos":
        guesses.append(f"~/Library/Application Support/{name}")
    return [g for g in guesses if os.path.exists(os.path.expanduser(g))]


def no_windows(command):
    if OS == "windows":
        sys.exit(f"error: `dotfiles {command}` isn't supported on Windows yet")


def split_tools(tools):
    return ({n: t for n, t in tools.items() if n not in local_names},
            {n: t for n, t in tools.items() if n in local_names})


def commit_hint(paths):
    print(f"\nReview, then commit: git add {' '.join(paths)}")


# --- commands ------------------------------------------------------------------------

def choose(args, tools, build, title):
    """Resolve the plan from TOOL args, --all, or the interactive picker. None means aborted."""
    unknown = [t for t in args.tools if t not in tools]
    if unknown:
        sys.exit(f"error: unknown tool(s): {', '.join(unknown)} (see `dotfiles list`)")
    if args.all and args.tools:
        sys.exit("error: pass tools or --all, not both")

    if args.all or args.tools:
        return build(list(tools) if args.all else list(dict.fromkeys(args.tools)))

    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        sys.exit("error: pass tools or --all (interactive picker needs a terminal)")
    plan = build(list(tools))
    if plan:
        plan = pick(plan, title)
        if plan is not None:
            print()
    return plan


def proceed(args):
    if args.dry_run:
        return False
    if not args.yes and not confirm("\nProceed? [y/N] "):
        print("Aborted")
        return False
    print()
    return True


def report(failed, done):
    if failed:
        print(f"\n{RED}✗ Failed: {', '.join(failed)}{NC}")
        return 1
    print(f"\n{GREEN}✓ {done}{NC}")
    return 0


def cmd_install(args):
    tools = load_tools()
    plan = choose(args, tools, lambda names: build_install_plan(names, tools), "Select tools to install")
    if plan is None:
        print("Aborted")
        return 1
    if not plan and not args.all:
        print(f"{GREEN}✓{NC} Nothing to install")
        return 0

    print_plan(plan)
    if args.all:
        print(f"{BLUE}all configs{NC}\n  link       everything in install.conf.yaml")
    if not proceed(args):
        return 0 if args.dry_run else 1
    return report(execute_install(plan, link_all=args.all), "Install complete")


def cmd_reset(args):
    tools = load_tools()
    plan = choose(
        args, tools, lambda names: build_reset_plan(names, tools, include_unclaimed=not args.tools), "Select tools to reset"
    )
    if plan is None:
        print("Aborted")
        return 1
    if not plan:
        print(f"{GREEN}✓{NC} Nothing to reset")
        return 0

    print_plan(plan)
    if not proceed(args):
        return 0 if args.dry_run else 1
    return report(execute_reset(plan), "Reset complete")


def cmd_upgrade(args):
    if OS == "linux":
        # Arch doesn't support partial upgrades: upgrading single packages against
        # a stale system can break it, so always upgrade everything.
        print("Arch doesn't support partial upgrades, so this upgrades the whole system:")
        print(f"{BLUE}system{NC}\n  run        paru -Syu")
        if not proceed(args):
            return 0 if args.dry_run else 1
        return report([] if subprocess.run(["paru", "-Syu"]).returncode == 0 else ["system"], "Upgrade complete")

    tools = load_tools()
    plan = choose(args, tools, lambda names: build_upgrade_plan(names, tools), "Select tools to upgrade")
    if plan is None:
        print("Aborted")
        return 1
    if not plan:
        print(f"{GREEN}✓{NC} Everything is up to date")
        return 0

    print_plan(plan)
    if not proceed(args):
        return 0 if args.dry_run else 1
    return report(execute_upgrade(plan), "Upgrade complete")


def ask_config(name, args):
    """Config paths for a new tool: --config as given, or the guesses the user accepts."""
    if args.config is not None:
        missing = [p for p in args.config if not os.path.exists(os.path.expanduser(p))]
        if missing:
            sys.exit(f"error: no such file or directory: {', '.join(missing)}")
        return list(dict.fromkeys(home_path(p) for p in args.config))
    guesses = config_guesses(name)
    if args.dry_run:
        for g in guesses:
            print(f"{DIM}found {g}, would ask whether it's {name}'s config{NC}")
    if args.yes or args.dry_run or not sys.stdin.isatty():
        return []  # never record a guess without asking
    return [g for g in guesses if confirm(f"Is {g} {name}'s config? [y/N] ")]


def cmd_add(args):
    no_windows("add")
    tools = load_tools()
    tracked, local = split_tools(tools)
    name = args.name
    if not re.fullmatch(r"[A-Za-z0-9][\w.+@-]*", name):
        sys.exit(f"error: {name!r} isn't a valid tool name")
    if name in tools:
        sys.exit(f"error: {name} is already in {LOCAL_FILE if name in local else 'tools.yaml'}")

    packages = {"macos": args.macos, "linux": args.linux, "windows": args.windows}
    packages[OS] = args.packages + packages[OS]
    if not any(packages.values()):
        packages[OS] = [name]  # `dotfiles add jq` installs the package jq
    tool = {k: v for k, v in packages.items() if v}
    if args.tracked:
        if args.config is not None:
            sys.exit("error: --config with --tracked isn't supported yet")
        check_collisions({**tracked, name: tool}, local)
    else:
        check_collisions(tracked, {**local, name: tool}, fix="")

    config = [] if args.tracked else ask_config(name, args)
    file = "tools.yaml" if args.tracked else LOCAL_FILE
    block = tool_block(name, packages, config)
    plan = build_install_plan([name], {name: tool})

    print(f"{BLUE}{file}{NC}\n  add        " + block.replace("\n", "\n             "))
    print_plan(plan)
    if not proceed(args):
        return 0 if args.dry_run else 1

    write_text(file, append_block(read_text(file) or ("" if args.tracked else LOCAL_HEADER), block))
    print(f"{GREEN}✓{NC} Added {name} to {file}")
    failed = execute_install(plan, link_all=False) if plan else []
    if args.tracked:
        commit_hint([file])
    return report(failed, f"{name} is ready")


def cmd_remove(args):
    no_windows("remove")
    tools = load_tools()
    name = args.name
    if name not in tools:
        sys.exit(f"error: unknown tool: {name} (see `dotfiles list`)")
    file = LOCAL_FILE if name in local_names else "tools.yaml"
    in_repo = [p for p in tools[name].get("links", []) if os.path.exists(os.path.join(REPO, p))]

    plan = build_reset_plan([name], tools)
    print_plan(plan)
    print(f"{BLUE}{file}{NC}\n  delete     {name}")
    if not proceed(args):
        return 0 if args.dry_run else 1

    failed = execute_reset(plan)
    if failed:
        return report(failed, "")  # keep the entry so the reset can be retried
    write_text(file, remove_block(read_text(file), name))
    print(f"{GREEN}✓{NC} Removed {name} from {file}")
    if in_repo:
        print(f"{YELLOW}!{NC} Its config is still in the repo: {', '.join(in_repo)} (and install.conf.yaml)")
    if file == "tools.yaml":
        commit_hint([file])
    return report([], f"{name} is removed")


# --- vendored dotbot ----------------------------------------------------------------

DOTBOT_REPO = "anishathalye/dotbot"


def version_key(version):
    return tuple(int(n) for n in version.split("."))


def vendored_dotbot_version():
    # where __version__ lives: 1.23+ / 1.21-1.22 / 1.20
    for path in ("src/dotbot/__about__.py", "src/dotbot/__init__.py", "dotbot/__init__.py"):
        try:
            with open(os.path.join(REPO, "dotbot", *path.split("/"))) as f:
                match = re.search(r'__version__ = "([^"]+)"', f.read())
        except OSError:
            continue
        if match:
            return match.group(1)
    sys.exit("error: can't find the vendored dotbot version in dotbot/")


# Older releases need Python 2 support or a pyyaml git submodule the tarball doesn't include
MIN_DOTBOT_VERSION = "1.20.0"


def dotbot_versions():
    """All vX.Y.Z tags, oldest first; tags are more complete than GitHub releases for dotbot."""
    url = f"https://api.github.com/repos/{DOTBOT_REPO}/tags?per_page=100"
    with urllib.request.urlopen(url, timeout=15) as resp:
        tags = [t["name"][1:] for t in json.load(resp) if re.fullmatch(r"v\d+\.\d+\.\d+", t["name"])]
    return sorted(tags, key=version_key)


def replace_dotbot(version):
    """Swap dotbot/ for the release tarball's contents, restoring the old copy on failure."""
    url = f"https://github.com/{DOTBOT_REPO}/archive/refs/tags/v{version}.tar.gz"
    target = os.path.join(REPO, "dotbot")
    with tempfile.TemporaryDirectory() as tmp:
        archive = os.path.join(tmp, "dotbot.tar.gz")
        with urllib.request.urlopen(url, timeout=60) as resp, open(archive, "wb") as f:
            shutil.copyfileobj(resp, f)

        with tarfile.open(archive) as tar:
            for member in tar.getmembers():  # no absolute paths or ../ escapes
                path = os.path.normpath(member.name)
                if path.startswith(("/", "..")) or os.path.isabs(path):
                    raise RuntimeError(f"unsafe path in archive: {member.name}")
            tar.extractall(tmp)
        extracted = os.path.join(tmp, f"dotbot-{version}")
        if not os.path.isfile(os.path.join(extracted, "bin", "dotbot")):
            raise RuntimeError("archive doesn't look like dotbot (no bin/dotbot)")

        backup = os.path.join(tmp, "old-dotbot")
        shutil.move(target, backup)
        try:
            shutil.move(extracted, target)
        except Exception:
            if os.path.exists(target):
                shutil.rmtree(target)
            shutil.move(backup, target)
            raise


def cmd_dotbot(args):
    current = vendored_dotbot_version()
    try:
        versions = dotbot_versions()
    except (OSError, ValueError) as e:
        sys.exit(f"error: couldn't check GitHub for dotbot versions: {e}")
    latest = versions[-1]

    if args.list:
        for v in reversed(versions):
            if version_key(v) < version_key(MIN_DOTBOT_VERSION):
                break
            marks = [m for m, on in (("installed", v == current), ("latest", v == latest)) if on]
            line = f"{v}  {DIM}({', '.join(marks)}){NC}" if marks else v
            print(f"{GREEN}{line}{NC}" if v == current else line)
        return 0

    if args.version:
        target = args.version.lstrip("v")
        if target not in versions:
            sys.exit(f"error: no dotbot version {target} (see `dotfiles dotbot --list`)")
        if version_key(target) < version_key(MIN_DOTBOT_VERSION):
            sys.exit(f"error: versions before {MIN_DOTBOT_VERSION} aren't supported")
    elif args.update:
        target = latest
    else:
        # just check
        if version_key(latest) <= version_key(current):
            print(f"{GREEN}✓{NC} Dotbot {current} is up to date")
        else:
            print(f"Dotbot {BLUE}{current}{NC} → {GREEN}{latest}{NC} available")
            print(f"  changes: https://github.com/{DOTBOT_REPO}/compare/v{current}...v{latest}")
            print("Run `dotfiles dotbot --update` to update the vendored copy.")
        return 0

    if target == current:
        print(f"{GREEN}✓{NC} Dotbot is already {current}")
        return 0
    verb = "update" if version_key(target) > version_key(current) else "downgrade"
    low, high = sorted([current, target], key=version_key)
    print(f"Dotbot {BLUE}{current}{NC} → {GREEN}{target}{NC} ({verb})")
    print(f"  changes: https://github.com/{DOTBOT_REPO}/compare/v{low}...v{high}")

    dirty = subprocess.run(
        ["git", "status", "--porcelain", "--", "dotbot"], cwd=REPO, capture_output=True, text=True
    ).stdout.strip()
    if dirty:
        sys.exit("error: dotbot/ has uncommitted changes; commit or discard them first")
    if not args.yes and not confirm(f"\nReplace dotbot/ with {target}? [y/N] "):
        print("Aborted")
        return 1

    print(f"{YELLOW}→{NC} Downloading dotbot {target}...")
    try:
        replace_dotbot(target)
    except (OSError, RuntimeError, tarfile.TarError) as e:
        print(f"{RED}✗{NC} {verb.capitalize()} failed, dotbot/ left unchanged: {e}")
        return 1

    print(f"{GREEN}✓{NC} Dotbot is now {vendored_dotbot_version()}\n")
    subprocess.run(["git", "status", "--short", "--", "dotbot"], cwd=REPO)
    print(f"\nReview, then commit: git add dotbot && git commit -m \"chore: {verb} dotbot to {target}\"")
    return 0


def cmd_link(args):
    try:
        run_dotbot("install.conf.yaml")
    except subprocess.CalledProcessError as e:
        return e.returncode
    return 0


def cmd_list(args):
    tools = load_tools()
    links = install_links()
    installed = installed_packages()
    width = max(len(n) for n in tools)
    print(f"{DIM}{'TOOL':<{width}}  LINKED  PACKAGES{NC}")
    heading = False
    for name, tool in tools.items():
        mine = unique([l for l in tool_links(tool, links) if applies(l)])
        pkgs = tool.get(OS, [])
        if not mine and not pkgs and not (tool.get("install") or {}).get(OS):
            continue  # nothing for this OS
        if name in local_names and not heading:
            print(f"\n{DIM}local ({LOCAL_FILE}){NC}")
            heading = True
        linked = f"{sum(1 for l in mine if owned(l))}/{len(mine)}" if mine else "-"
        shown = " ".join(
            f"{GREEN}{p}{NC}" if is_installed(p, installed) else f"{DIM}{p} (not installed){NC}" for p in pkgs
        )
        print(f"{name:<{width}}  {linked:<6}  {shown or '-'}")
        # where the tool's config lives: its link destinations, or a local tool's config: paths
        config = [l["key"] for l in mine] + tool.get("config", [])
        if config:
            print(f"{'':<{width}}  {DIM}config  {' '.join(config)}{NC}")
    return 0


def cmd_outdated(args):
    """Quiet, one package per line, for the shell greeting to count."""
    outdated = outdated_packages(quiet=True) if OS == "macos" else None
    if outdated is None:
        sys.exit("error: outdated is only supported on macOS")
    installed = installed_packages()
    for tool in load_tools().values():
        for p in tool.get(OS, []):
            if is_installed(p, installed) and pkg_name(p) in outdated:
                print(p)
    return 0


def main():
    parser = argparse.ArgumentParser(prog="dotfiles", description="Install, link and reset this dotfiles repo.")
    sub = parser.add_subparsers(dest="command", metavar="COMMAND")

    for name, func, help_text, all_help in [
        ("install", cmd_install, "install packages and link configs", "install every tool and link all configs"),
        ("reset", cmd_reset, "unlink configs and uninstall packages", "reset every tool and remove all dotfiles symlinks"),
        ("upgrade", cmd_upgrade, "upgrade installed packages", "upgrade every tool (on Arch: always the whole system)"),
    ]:
        p = sub.add_parser(name, help=help_text)
        p.add_argument("tools", nargs="*", metavar="TOOL", help="tools to act on (default: pick interactively)")
        p.add_argument("--all", action="store_true", help=all_help)
        p.add_argument("-n", "--dry-run", action="store_true", help="show what would happen, change nothing")
        p.add_argument("-y", "--yes", action="store_true", help="don't ask for confirmation")
        p.set_defaults(func=func)

    p = sub.add_parser("add", help=f"add a tool to {LOCAL_FILE} (or tools.yaml) and install it")
    p.add_argument("name", metavar="NAME", help="tool name")
    p.add_argument("packages", nargs="*", metavar="PKG", help="packages for this OS (default: NAME)")
    for os_name in ("macos", "linux", "windows"):
        p.add_argument(f"--{os_name}", nargs="+", action="extend", default=[], metavar="PKG",
                       help=f"packages for {os_name}")
    p.add_argument("--config", nargs="+", action="extend", metavar="PATH",
                   help="the tool's config files (default: ask about the usual places)")
    p.add_argument("--tracked", action="store_true", help=f"add it to tools.yaml instead of {LOCAL_FILE}")
    p.add_argument("-n", "--dry-run", action="store_true", help="show what would happen, change nothing")
    p.add_argument("-y", "--yes", action="store_true", help="don't ask for confirmation")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("remove", help="reset a tool and delete it from its tools file")
    p.add_argument("name", metavar="NAME", help="tool name")
    p.add_argument("-n", "--dry-run", action="store_true", help="show what would happen, change nothing")
    p.add_argument("-y", "--yes", action="store_true", help="don't ask for confirmation")
    p.set_defaults(func=cmd_remove)

    sub.add_parser("link", help="re-run dotbot to (re)create all symlinks").set_defaults(func=cmd_link)

    p = sub.add_parser("dotbot", help="check, update or pin the vendored Dotbot version")
    p.add_argument("version", nargs="?", metavar="VERSION", help="switch dotbot/ to this version (up or down)")
    p.add_argument("--update", action="store_true", help="switch dotbot/ to the newest version")
    p.add_argument("--list", action="store_true", help="list available versions")
    p.add_argument("-y", "--yes", action="store_true", help="don't ask for confirmation")
    p.set_defaults(func=cmd_dotbot)
    sub.add_parser("list", help="show tools and what's linked/installed").set_defaults(func=cmd_list)
    sub.add_parser("outdated", help="print outdated packages from tools.yaml (macOS)").set_defaults(func=cmd_outdated)

    args = parser.parse_args()
    if OS is None:
        sys.exit(f"error: unsupported platform: {sys.platform}")
    if not args.command:
        parser.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:  # output piped into e.g. `head`
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)
