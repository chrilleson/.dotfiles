#!/usr/bin/env python3
"""dotfiles: install, link and reset this dotfiles repo.

  dotfiles install            run this OS's install script
  dotfiles link               re-run dotbot (symlinks only)
  dotfiles list               show tools and what's linked/installed
  dotfiles reset              pick tools to reset interactively
  dotfiles reset TOOL...      reset specific tools (-n preview, -y no prompt)
  dotfiles reset --all        reset everything

Tools are defined in reset.conf.yaml; symlinks come from install.conf.yaml.
Reset only removes symlinks that point into this repo, never real files.
On Windows the Nushell `dotfiles` command runs this through Python.
"""

import argparse
import os
import shutil
import subprocess
import sys

try:
    import yaml
except ImportError:
    sys.exit("error: PyYAML is required (dotbot needs it too): python3 -m pip install pyyaml")

# shared/bin/dotfiles -> repo root (resolves the ~/.local/bin symlink)
REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
OS = {"darwin": "macos", "linux": "linux", "win32": "windows"}.get(sys.platform)

if sys.stdout.isatty():
    if OS == "windows":
        os.system("")  # enable ANSI escapes in the Windows console
    RED, GREEN, YELLOW, BLUE, DIM, NC = "\033[0;31m", "\033[0;32m", "\033[1;33m", "\033[0;34m", "\033[2m", "\033[0m"
else:
    RED = GREEN = YELLOW = BLUE = DIM = NC = ""


# --- repo config ---------------------------------------------------------------

def load_yaml(name):
    with open(os.path.join(REPO, name)) as f:
        return yaml.safe_load(f)


def load_tools():
    return {name: tool or {} for name, tool in load_yaml("reset.conf.yaml").items()}


def install_links():
    """(destination, repo source) pairs for every link in install.conf.yaml."""
    links = []
    for directive in load_yaml("install.conf.yaml"):
        for dest, spec in (directive.get("link") or {}).items():
            source = spec["path"] if isinstance(spec, dict) else spec
            links.append((os.path.expanduser(dest), source))
    return list(dict.fromkeys(links))  # same link can be listed per OS


def owned(dest, source):
    """True if dest is a symlink that points at source in this repo."""
    return os.path.islink(dest) and os.path.realpath(dest) == os.path.realpath(os.path.join(REPO, source))


def under(source, prefixes):
    return any(source == p or source.startswith(p.rstrip("/") + "/") for p in prefixes)


# --- package managers ------------------------------------------------------------

def scoop():
    return shutil.which("scoop") or "scoop"


def installed_packages():
    """Names of everything installed by this OS's package manager."""
    try:
        if OS == "macos":
            out = subprocess.run(["brew", "list", "-1"], capture_output=True, text=True).stdout
            return set(out.split())
        if OS == "linux":
            out = subprocess.run(["pacman", "-Qq"], capture_output=True, text=True).stdout
            return set(out.split())
        apps = os.path.join(os.environ.get("SCOOP") or os.path.expanduser("~/scoop"), "apps")
        return {name.lower() for name in os.listdir(apps)}
    except OSError:
        return set()


def is_installed(pkg, installed):
    return (pkg.lower() if OS == "windows" else pkg) in installed


def uninstall_cmd(pkgs):
    return {
        "macos": ["brew", "uninstall"] + pkgs,
        "linux": ["paru", "-Rns", "--noconfirm"] + pkgs,
        "windows": [scoop(), "uninstall"] + pkgs,
    }[OS]


# --- reset -----------------------------------------------------------------------

def build_plan(names, tools, include_unclaimed=False):
    """Per tool: symlinks to remove, commands to run, installed packages to uninstall."""
    links = install_links()
    installed = installed_packages()
    plan = []
    for name in names:
        tool = tools[name]
        plan.append({
            "name": name,
            "links": [d for d, s in links if under(s, tool.get("links", [])) and owned(d, s)],
            "run": (tool.get("run") or {}).get(OS, []),
            "packages": [p for p in tool.get(OS, []) if is_installed(p, installed)],
        })

    if include_unclaimed:
        claimed = [p for t in tools.values() for p in t.get("links", [])]
        rest = [d for d, s in links if not under(s, claimed) and owned(d, s)]
        if rest:
            plan.append({"name": "other links", "links": rest, "run": [], "packages": []})

    return [step for step in plan if step["links"] or step["run"] or step["packages"]]


def summary(step):
    parts = []
    if step["links"]:
        parts.append(f"unlink {len(step['links'])}")
    if step["run"]:
        parts.append(f"run {len(step['run'])}")
    if step["packages"]:
        parts.append("uninstall " + " ".join(step["packages"]))
    return " · ".join(parts)


def print_plan(plan):
    for step in plan:
        print(f"{BLUE}{step['name']}{NC}")
        for dest in step["links"]:
            print(f"  unlink     {dest}")
        for cmd in step["run"]:
            print(f"  run        {cmd}")
        if step["packages"]:
            print(f"  uninstall  {' '.join(step['packages'])}")


def unlink(path):
    try:
        os.unlink(path)
    except (IsADirectoryError, PermissionError):
        os.rmdir(path)  # directory symlinks on Windows


def execute(plan):
    failed = []
    for step in plan:
        print(f"{YELLOW}→{NC} Resetting {step['name']}...")
        try:
            for dest in step["links"]:
                unlink(dest)
            for cmd in step["run"]:
                subprocess.run(cmd, shell=True, check=True)
            if step["packages"]:
                subprocess.run(uninstall_cmd(step["packages"]), check=True)
        except (OSError, subprocess.CalledProcessError) as e:
            print(f"{RED}✗{NC} {step['name']}: {e}")
            failed.append(step["name"])
        else:
            print(f"{GREEN}✓{NC} {step['name']}")
    return failed


def confirm(prompt):
    try:
        return input(prompt).strip().lower() in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


# --- interactive picker ------------------------------------------------------------

UP, DOWN, TOGGLE, ALL, DONE, QUIT = "up", "down", "toggle", "all", "done", "quit"


def read_keys():
    """Yield key actions from the terminal until the caller stops."""
    if OS == "windows":
        import msvcrt
        while True:
            ch = msvcrt.getwch()
            if ch in ("\x00", "\xe0"):
                ch = {"H": UP, "P": DOWN}.get(msvcrt.getwch())
            yield key_action(ch)
    else:
        import termios
        import tty
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setcbreak(fd)
            while True:
                seq = os.read(fd, 3).decode(errors="ignore")
                yield {"\x1b[A": UP, "\x1b[B": DOWN}.get(seq) or key_action(seq)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)


def key_action(ch):
    return {
        UP: UP, DOWN: DOWN, "k": UP, "j": DOWN,
        " ": TOGGLE, "a": ALL,
        "\r": DONE, "\n": DONE,
        "q": QUIT, "\x1b": QUIT, "\x03": QUIT,
    }.get(ch)


def fit(text, room):
    """Cut text to room characters so terminal lines never wrap (wrapping breaks redraws)."""
    return text if len(text) <= room else text[:max(room - 1, 0)] + "…"


def pick(plan):
    """Checkbox menu over plan steps; returns the chosen steps, or None if cancelled."""
    selected = [False] * len(plan)
    cursor, top, drawn = 0, 0, 0
    height = max(3, min(len(plan), shutil.get_terminal_size().lines - 5))
    width = max(len(s["name"]) for s in plan)

    def draw():
        nonlocal drawn
        cols = shutil.get_terminal_size().columns - 1  # writing the last column can wrap too
        lines = [
            fit("Select tools to reset", cols),
            DIM + fit("↑/↓ move · space toggle · a all · enter confirm · q quit", cols) + NC,
        ]
        for i in range(top, min(top + height, len(plan))):
            mark = f"{GREEN}[x]{NC}" if selected[i] else "[ ]"
            pointer = f"{BLUE}>{NC}" if i == cursor else " "
            name = fit(plan[i]["name"], cols - 6).ljust(width)
            detail = fit(summary(plan[i]), cols - 6 - width - 2)
            lines.append(f"{pointer} {mark} {name}  {DIM}{detail}{NC}")
        if drawn:
            sys.stdout.write(f"\033[{drawn}F")
        sys.stdout.write("\033[J" + "\n".join(lines) + "\n")
        sys.stdout.flush()
        drawn = len(lines)

    sys.stdout.write("\033[?25l")  # hide cursor
    try:
        draw()
        for action in read_keys():
            if action == UP:
                cursor = (cursor - 1) % len(plan)
            elif action == DOWN:
                cursor = (cursor + 1) % len(plan)
            elif action == TOGGLE:
                selected[cursor] = not selected[cursor]
            elif action == ALL:
                selected = [not all(selected)] * len(plan)
            elif action == DONE:
                return [s for s, on in zip(plan, selected) if on]
            elif action == QUIT:
                return None
            top = min(max(top, cursor - height + 1), cursor)
            draw()
    except KeyboardInterrupt:
        return None
    finally:
        sys.stdout.write("\033[?25h")  # show cursor
        sys.stdout.flush()


# --- commands ------------------------------------------------------------------------

def cmd_install(args):
    script = {
        "macos": ["bash", "macos/install.sh"],
        "linux": ["bash", "linux/install.sh"],
        "windows": ["nu", "windows/install.nu"],
    }[OS]
    return subprocess.run(script + args.extra, cwd=REPO).returncode


def cmd_link(args):
    env = dict(os.environ)
    if OS != "windows":
        env["SHELL"] = "/bin/bash"
    dotbot = [sys.executable, os.path.join("dotbot", "bin", "dotbot"), "-d", ".", "-c", "install.conf.yaml"]
    return subprocess.run(dotbot, cwd=REPO, env=env).returncode


def cmd_list(args):
    tools = load_tools()
    links = install_links()
    installed = installed_packages()
    width = max(len(n) for n in tools)
    print(f"{DIM}{'TOOL':<{width}}  LINKED  PACKAGES{NC}")
    for name, tool in tools.items():
        linked = sum(1 for d, s in links if under(s, tool.get("links", [])) and owned(d, s))
        pkgs = tool.get(OS, [])
        if not linked and not pkgs:
            continue  # nothing for this OS
        shown = " ".join(
            f"{GREEN}{p}{NC}" if is_installed(p, installed) else f"{DIM}{p} (not installed){NC}" for p in pkgs
        )
        print(f"{name:<{width}}  {str(linked) if linked else '-':<6}  {shown or '-'}")
    return 0


def cmd_reset(args):
    tools = load_tools()
    unknown = [t for t in args.tools if t not in tools]
    if unknown:
        sys.exit(f"error: unknown tool(s): {', '.join(unknown)} (see `dotfiles list`)")
    if args.all and args.tools:
        sys.exit("error: pass tools or --all, not both")

    if args.all or args.tools:
        names = list(tools) if args.all else list(dict.fromkeys(args.tools))
        plan = build_plan(names, tools, include_unclaimed=args.all)
    else:
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            sys.exit("error: pass tools or --all (interactive picker needs a terminal)")
        plan = build_plan(list(tools), tools, include_unclaimed=True)
        if plan:
            plan = pick(plan)
            if plan is None:
                print("Aborted")
                return 1
            print()

    if not plan:
        print(f"{GREEN}✓{NC} Nothing to reset")
        return 0

    print_plan(plan)
    if args.dry_run:
        return 0
    if not args.yes and not confirm("\nProceed? [y/N] "):
        print("Aborted")
        return 1

    print()
    failed = execute(plan)
    if failed:
        print(f"\n{RED}✗ Failed: {', '.join(failed)}{NC}")
        return 1
    print(f"\n{GREEN}✓ Reset complete{NC}")
    return 0


def main():
    parser = argparse.ArgumentParser(prog="dotfiles", description="Install, link and reset this dotfiles repo.")
    sub = parser.add_subparsers(dest="command", metavar="COMMAND")

    p = sub.add_parser("install", help="run this OS's install script")
    p.add_argument("extra", nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("link", help="re-run dotbot to (re)create symlinks")
    p.set_defaults(func=cmd_link)

    p = sub.add_parser("list", help="show tools and what's linked/installed")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("reset", help="unlink configs and uninstall packages")
    p.add_argument("tools", nargs="*", metavar="TOOL", help="tools to reset (default: pick interactively)")
    p.add_argument("--all", action="store_true", help="reset every tool and remove all dotfiles symlinks")
    p.add_argument("-n", "--dry-run", action="store_true", help="show what would be removed, change nothing")
    p.add_argument("-y", "--yes", action="store_true", help="don't ask for confirmation")
    p.set_defaults(func=cmd_reset)

    args = parser.parse_args()
    if OS is None:
        sys.exit(f"error: unsupported platform: {sys.platform}")
    if not args.command:
        parser.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
