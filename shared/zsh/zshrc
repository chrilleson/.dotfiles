# --- history ---
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS

# --- behavior ---
setopt AUTO_CD INTERACTIVE_COMMENTS

# --- OS-specific: Homebrew, fpath, plugin paths (before compinit and tools) ---
[[ -f ~/.zshrc.os ]] && source ~/.zshrc.os

# --- paths ---
typeset -U path   # dedupe PATH
path=(~/.local/bin ~/.local/share/bun/bin $path)

# --- XDG-compliant tool locations ---
export BUN_INSTALL=~/.local/share/bun
export NUGET_PACKAGES=~/.cache/NuGet/packages

# --- completion (full rebuild at most once a day) ---
autoload -Uz compinit
() {
  setopt localoptions extendedglob
  if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then compinit; else compinit -C; fi
}
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

# --- tools ---
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"
command -v fnm      >/dev/null && eval "$(fnm env --use-on-cd --shell zsh)"
command -v fzf      >/dev/null && source <(fzf --zsh)
# after fzf so atuin takes Ctrl-R; Up arrow keeps plain history
command -v atuin    >/dev/null && eval "$(atuin init zsh --disable-up-arrow)"
command -v pass-cli >/dev/null && source <(pass-cli completions zsh)

# --- dev: open or attach to a tmux dev session for the current directory ---
dev() {
  # tmux rewrites "." and ":" in session names to "_", so sanitize up front
  local session=${${PWD:t}//[.:]/_}

  if ! tmux has-session -t "=$session" 2>/dev/null; then
    tmux new-session -d -s "$session" -n editor
    tmux new-window  -t "$session" -n server
    tmux new-window  -t "$session" -n git
    tmux new-window  -t "$session" -n misc
    tmux select-window -t "$session:editor"
  fi

  if [[ -n $TMUX ]]; then
    tmux switch-client -t "$session"
  else
    tmux attach -t "$session"
  fi
}

# --- man pages via bat ---
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# --- aliases ---
# modern ls via eza
alias ls='eza -al --color=always --group-directories-first --icons=always'
alias la='eza -a --color=always --group-directories-first --icons=always'
alias ll='eza -l --color=always --group-directories-first --icons=always'
alias lt='eza -aT --color=always --group-directories-first --icons=always'
alias l.="eza -a | grep -e '^\.'"
# cd navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'
# colorized grep
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# --- plugins (syntax-highlighting must be last) ---
[[ -r $ZSH_AUTOSUGGEST_PATH ]] && source $ZSH_AUTOSUGGEST_PATH
[[ -r $ZSH_SYNTAX_HL_PATH   ]] && source $ZSH_SYNTAX_HL_PATH


# --- greeting: system info on every new shell ---
command -v fastfetch >/dev/null && fastfetch
# OS-specific additions from ~/.zshrc.os (e.g. pending upgrades on Linux)
(( $+functions[os_greeting] )) && os_greeting
